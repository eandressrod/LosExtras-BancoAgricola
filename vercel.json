{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/mensajes", "destination": "/api/recursos?recurso=mensajes" },
    { "source": "/api/metas", "destination": "/api/recursos?recurso=metas" },
    { "source": "/api/promociones-apertura", "destination": "/api/recursos?recurso=promociones-apertura" },
    { "source": "/api/guardadas", "destination": "/api/recursos?recurso=guardadas" }
  ],
  "headers": [
    {
      "source": "/pwa/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
