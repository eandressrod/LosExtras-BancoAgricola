{
  "name": "los-extras-banco-agricola",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:remote": "node --env-file-if-exists=.env --test tests/remote/*.test.js",
    "test:e2e": "playwright test",
    "test:regreso": "node scripts/prueba-regreso.js",
    "respaldo": "node --env-file-if-exists=.env scripts/respaldo.js",
    "hash": "node scripts/generar-hash.js",
    "catalogo:generar": "node scripts/catalogo/generar.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "supabase": "2.120.0"
  }
}
